# =============================================================================
#  .htaccess DEFINITIVO para la raíz de public_html
#
#  Este archivo REEMPLAZA a los dos que hay hoy:
#    · el .htaccess de la raíz   (hoy sólo canoniza y cachea el sitio viejo)
#    · el de public_html/nuevo/  (URLs limpias del sitio nuevo)
#
#  Se sube cuando el sitio nuevo pasa a la raíz. Hace las dos cosas a la vez.
#
#  CÓMO INSTALARLO
#    1. Renombrar este archivo a .htaccess
#    2. Subirlo a public_html/, reemplazando el que está
#    3. Abrir https://dekarter.cl de inmediato
#
#  SI SALE ERROR 500: borrar el archivo del servidor. El sitio vuelve al
#  instante. Un .htaccess no deja nada modificado de forma permanente.
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # -------------------------------------------------------------------------
    #  1. Una sola dirección buena: https://dekarter.cl
    #
    #  Va primero a propósito. Todo lo que sigue tiene que ocurrir ya sobre la
    #  dirección definitiva, no sobre una de las otras tres.
    # -------------------------------------------------------------------------
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://dekarter.cl%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # -------------------------------------------------------------------------
    #  2. Restos del sitio anterior
    #
    #  Si alguien tiene guardadas estas direcciones, o Google todavía las
    #  conserva indexadas, que lleguen a algún lado en vez de dar 404.
    # -------------------------------------------------------------------------
    RewriteRule ^indexfinal3\.html$ / [R=301,L]

    # /index.php -> / . Sin esta regla, la regla 4 lo mandaría a /index, que es
    # una dirección fea y además duplicada de la portada.
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # -------------------------------------------------------------------------
    #  3. El mapa del sitio
    #
    #  Google espera /sitemap.xml. El archivo real es sitemap.php, que lo genera
    #  desde inc/config.php para que no pueda quedar desactualizado. Se sirve sin
    #  redirigir: para el visitante la dirección sigue siendo /sitemap.xml.
    # -------------------------------------------------------------------------
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # -------------------------------------------------------------------------
    #  4. Direcciones con .php -> versión limpia, con un 301
    #
    #  %1 trae la ruta completa desde la raíz, porque THE_REQUEST es la petición
    #  cruda. Por eso el destino es /%1 y no %1.
    # -------------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # -------------------------------------------------------------------------
    #  5. URLs limpias: /contacto sirve contacto.php
    #     Sólo si el .php existe de verdad; si no, sigue de largo hasta el 404.
    # -------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^/.]+)/?$ $1.php [L]

    # -------------------------------------------------------------------------
    #  6. Nada de acceso directo a los includes ni a la carpeta de trabajo
    # -------------------------------------------------------------------------
    RewriteRule ^(inc|var)/ - [F,L]
</IfModule>

ErrorDocument 404 /404.php

# -----------------------------------------------------------------------------
#  Archivos que no se sirven nunca
# -----------------------------------------------------------------------------
<FilesMatch "\.(md|log|psd|ai|bak|sql|ini|sh)$">
    Require all denied
</FilesMatch>

<Files "error_log">
    Require all denied
</Files>

# -----------------------------------------------------------------------------
#  Compresión
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
#  Caché del navegador
#
#  El CSS y el JS llevan pegada su fecha de modificación en la dirección (la
#  función activo() de inc/config.php), así que se pueden cachear a un año sin
#  riesgo: al editarlos cambia la dirección y el navegador los vuelve a pedir.
#  Las imágenes no cambian nunca; si cambian, cambia el nombre del archivo.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 week"

    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"

    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|svg|css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # ---- Seguridad ----
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    Header unset X-Powered-By
    Header unset Server
</IfModule>

# -----------------------------------------------------------------------------
#  Tipos MIME que algunos hosting no traen configurados
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp                  .webp
    AddType image/svg+xml               .svg
    AddCharset UTF-8                    .php .html .css .js .xml
</IfModule>
