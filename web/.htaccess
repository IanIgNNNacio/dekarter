# =============================================================================
#  .htaccess para la RAÍZ de public_html — arreglo inmediato del sitio actual
#
#  INSTALADO Y VERIFICADO el 22-08-2026. Comprobado en vivo:
#    · http://www.dekarter.cl/index.php  →  https://dekarter.cl/index.php
#    · dekarter.cl/images/engranajes.psd  →  403
#    · imágenes con Cache-Control (antes no mandaba ninguna cabecera de caché)
#
#  Arregla tres cosas del sitio en producción, sin tocar una línea de index.php:
#
#    1. Hoy https://dekarter.cl, http://dekarter.cl, https://www.dekarter.cl y
#       http://www.dekarter.cl devuelven las cuatro un 200. Para Google son
#       cuatro sitios distintos con el mismo contenido, y el peso de
#       posicionamiento se reparte entre los cuatro. Peor: el formulario de
#       contacto se puede enviar por HTTP sin cifrar.
#    2. Las imágenes se sirven sin ninguna cabecera de caché: cada visita
#       vuelve a descargar los 4 MB completos.
#    3. Los .psd del taller se pueden descargar desde el navegador. El archivo
#       images/engranajes.psd pesa 20 MB y está público.
#
#  CÓMO INSTALARLO
#    1. Renombrar este archivo a .htaccess (con el punto adelante).
#    2. Subirlo por FileZilla a public_html/ (la raíz, no la subcarpeta nuevo).
#    3. Abrir http://dekarter.cl en el navegador: debe saltar a
#       https://dekarter.cl. Probar también con www.
#
#  SI ALGO SALE MAL: borrar el archivo del servidor y todo vuelve a estar como
#  antes. Un .htaccess no modifica nada permanente.
# =============================================================================

Options -Indexes

# -----------------------------------------------------------------------------
#  Una sola dirección buena: https://dekarter.cl
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # http  ->  https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://dekarter.cl%{REQUEST_URI} [R=301,L]

    # www  ->  sin www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
#  Que no se puedan descargar los archivos de trabajo
# -----------------------------------------------------------------------------
<FilesMatch "\.(psd|ai|log|bak|sql|md)$">
    Require all denied
</FilesMatch>

<Files "error_log">
    Require all denied
</Files>

# -----------------------------------------------------------------------------
#  Caché de imágenes y CSS
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 6 months"
    ExpiresByType image/png   "access plus 6 months"
    ExpiresByType image/webp  "access plus 6 months"
    ExpiresByType text/css    "access plus 1 month"
    ExpiresByType text/html   "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
